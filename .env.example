# reCAPTCHA v2 site key — the public half of the pair. Required: there is no fallback in
# src/config.ts, so a missing value fails the build. In CI this comes from the
# RECAPTCHA_SITE_KEY repository variable.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# URL of the AWS Lambda Function URL that verifies reCAPTCHA tokens.
# Required — there is deliberately no fallback in src/config.ts, so a missing value
# fails the build. In CI this comes from the CONTACT_VERIFY_URL repository variable.
# Example: https://abcdefghijkl.lambda-url.ap-southeast-1.on.aws/
NEXT_PUBLIC_CONTACT_VERIFY_URL=

# The secret key is NOT used by the website. Set it as the RECAPTCHA_SECRET_KEY
# environment variable on the Lambda function instead.
