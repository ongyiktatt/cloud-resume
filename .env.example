# Public reCAPTCHA v2 site key. Safe to expose to the browser.
# Optional: falls back to the key hardcoded in src/config.ts.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Ld7crUtAAAAADqptDfV8SH6wrdAqCHDLKV_N2G2

# URL of the AWS Lambda Function URL that verifies reCAPTCHA tokens.
# Example: https://abcdefghijkl.lambda-url.ap-southeast-1.on.aws/
NEXT_PUBLIC_CONTACT_VERIFY_URL=

# The secret key is NOT used by the website. Set it as the RECAPTCHA_SECRET_KEY
# environment variable on the Lambda function instead.
