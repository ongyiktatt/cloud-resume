# Yarn 1 checks every manifest in the tree for workspaces. `eslint` publishes a
# top-level "workspaces" field without "private": true, so Yarn prints
# "warning Workspaces can only be enabled in private projects." once per
# dependency path on a clean install. This project does not use workspaces, so
# turn the feature off to silence the false positive. Genuine warnings (e.g.
# incorrect peer dependencies) are still reported.
workspaces-experimental false
