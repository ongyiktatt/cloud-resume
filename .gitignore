# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
tsconfig.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# latex — resume/resume.tex is the source of truth. The published PDF is committed at
# public/assets/Resume_Ong Yik Tatt.pdf so the site can be built without a TeX installation;
# CI regenerates it from the source on every deploy. Only the build by-products are ignored.
/resume/*.aux
/resume/*.fdb_latexmk
/resume/*.fls
/resume/*.log
/resume/*.out
/resume/*.pdf
/resume/*.synctex.gz

# terraform — aws/terraform/ is hand-maintained; only its local working files are ignored.
# `.terraform/` is the provider and module cache (hundreds of MB, machine-specific) and state can
# hold resource attributes, so neither belongs in a public repo.
**/.terraform/*
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Variable files commonly carry the contact-form notification address and other values this public
# repo is not allowed to publish. Force-add one with `git add -f` if it is genuinely safe to share.
*.tfvars
*.tfvars.json
# Local overrides and CLI config
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# NOTE: `.terraform.lock.hcl` is deliberately NOT ignored — it pins the provider versions every
# machine and CI run must resolve to, so it is meant to be committed.
